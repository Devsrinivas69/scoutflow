# =============================================================
# ScoutFlow — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your actual values.
# Set these same variables in Railway dashboard for production.
# Railway auto-injects DATABASE_URL and REDIS_URL from plugins.

# ─── Database (auto-injected by Railway PostgreSQL plugin) ───
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/scoutflow"

# ─── Redis (auto-injected by Railway Redis plugin) ───────────
REDIS_URL="redis://HOST:PORT"

# ─── NextAuth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://your-railway-app-url.up.railway.app"

# ─── Ocean.io (https://ocean.io) ─────────────────────────────
OCEAN_API_KEY="your-ocean-api-key"

# ─── Prospeo (https://prospeo.io) ────────────────────────────
PROSPEO_API_KEY="your-prospeo-api-key"


# ─── Resend (https://resend.com) ─────────────────────────────
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="contact@yourdomain.com"
RESEND_FROM_NAME="Your Company Name"
# RESEND_REPLY_TO="reply-to@yourdomain.com" # Optional


